    SupportedContact:
      type: object
      description: |-
        Serializer for SupportedContact model.
        Unified serializer that handles contact information for clients.
        A contact can optionally be marked as caregiver and/or emergency contact.

        The relationship field accepts different values based on contact_type:
        - When contact_type='family': use RelationshipType enum (mother, father, etc.)
        - When contact_type='professional': use ProfessionalContactType enum (case_manager, social_worker, etc.)
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        familyMemberId:
          type: string
          format: uuid
          writeOnly: true
        firstName:
          type: string
          maxLength: 100
        lastName:
          type: string
          maxLength: 100
        dateOfBirth:
          type: string
          format: date
          nullable: true
        phone:
          type: string
          maxLength: 20
        secondaryPhone:
          type: string
          description: Alternative/secondary phone number
          maxLength: 20
        email:
          type: string
          format: email
          maxLength: 254
        contactType:
          allOf:
          - $ref: '#/components/schemas/ContactTypeEnum'
          description: |-
            Type of contact (family or professional)

            * `family` - Family/Whānau
            * `professional` - Professional
        relationship:
          allOf:
          - $ref: '#/components/schemas/RelationshipEnum'
          description: |-
            Relationship to client. Valid values: RelationshipType when contact_type=family, ProfessionalContactType when contact_type=professional

            * `mother` - Mother
            * `father` - Father
            * `spouse_partner` - Spouse/Partner
            * `guardian` - Guardian
            * `nanny` - Nanny
            * `grandparent` - Grandparent
            * `aunty` - Aunty
            * `uncle` - Uncle
            * `sibling` - Sibling
            * `cousin` - Cousin
            * `neighbour` - Neighbour
            * `friend` - Friend
            * `other` - Other
            * `case_manager` - Case Manager
            * `social_worker` - Social Worker
            * `teacher` - Teacher
        isCaregiver:
          type: boolean
          description: Whether this contact is a caregiver for the client
        isEmergencyContact:
          type: boolean
          description: Whether this contact is an emergency contact for the client
        isPrimaryCaregiver:
          type: boolean
          description: Is this the primary caregiver?
        personName:
          type: string
          readOnly: true
        familyName:
          type: string
          readOnly: true
        isActive:
          type: boolean
        createdAt:
          type: string
          format: date-time
          readOnly: true
        updatedAt:
          type: string
          format: date-time
          readOnly: true
      required:
      - contactType
      - createdAt
      - familyMemberId
      - familyName
      - firstName
      - id
      - lastName
      - personName
      - relationship
      - updatedAt
