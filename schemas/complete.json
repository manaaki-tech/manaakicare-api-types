  /api/v1/referral/{referral_id}/documents/upload/:
    post:
      operationId: v1_referral_documents_upload_create
      description: |-
        Atomic document upload + referral linking.

        Uploads a file, creates a Document record, and links it to the referral
        in a single atomic transaction.

        Expected form-data:
        - file: File to upload (required)
        - title: Document title (required)
        - description: Document description (optional)
        - document_date: Date of the document (optional)
        - category_id: Document category UUID (optional)
        - tag_ids: Array of tag UUIDs (optional)
        - is_confidential: Boolean (default: false)
        - is_public: Boolean (default: false)
        - expiry_date: Expiry date (optional)
        - notes: Referral-specific notes about this document (optional)

        Returns: ReferralDocumentDetailSerializer with full document details
      parameters:
      - in: path
        name: referral_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - v1
      requestBody:
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ReferralDocumentUpload'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ReferralDocumentUpload'
          application/json:
            schema:
              $ref: '#/components/schemas/ReferralDocumentUpload'
        required: true
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ReferralDocumentUpload'
          description: ''
