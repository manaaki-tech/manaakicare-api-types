  /api/v1/service-episode/{id}/update-status/:
    patch:
      operationId: v1_service_episode_update_status_partial_update
      description: |-
        Update the status of a service episode with business rule validation.

        Business Rules:
        - If current status is AWAITING_COMMENCEMENT, it can be changed to any status
        - If current status is CLOSED or COMPLETED, status cannot be updated
        - If current status is AWAITING_COMMENCEMENT, ACTIVE, or ON_HOLD, status can be updated
        - If current status is any other status (not AWAITING_COMMENCEMENT),
          it cannot be reverted to AWAITING_COMMENCEMENT

        Required parameters:
        - status: New status value
        - reason: Optional reason for status change

        Example:
        PATCH /api/service-episodes/{id}/update-status/
        {
            "status": "active",
            "reason": "Client ready to begin services"
        }
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this Service Episode.
        required: true
      tags:
      - v1
      requestBody:
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedServiceEpisodeStatusUpdate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedServiceEpisodeStatusUpdate'
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedServiceEpisodeStatusUpdate'
      security:
      - jwtAuth: []
      responses:
        '200':
