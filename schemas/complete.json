          type: string
          enum:
          - educational
          - other
          - professional
          - self
          - whanau
        description: |-
          Type of referral

          * `self` - Self-referral
          * `whanau` - Whānau referral
          * `professional` - Professional referral
          * `educational` - Educational referral
          * `other` - Other referral
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: status
        schema:
          type: array
          items:
            type: string
        description: Multiple values may be separated by commas.
        explode: false
        style: form
      - in: query
        name: to_date
        schema:
          type: string
          format: date
      - in: query
        name: urgency_level
        schema:
          type: string
          enum:
          - crisis
          - emergency
          - priority
          - routine
          - urgent
        description: |-
          Urgency level of the referral

