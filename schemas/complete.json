  /api/v1/service-episode/:
    get:
      operationId: v1_service_episode_list
      description: |-
        ViewSet for ServiceEpisode model.
        Provides CRUD operations and specialized endpoints for staff management.

        Filtering:
        - Managers see all service episodes for services where they are assigned as manager
        - Case workers only see episodes they are directly assigned to

        Query Parameters:
        - service_id: Filter by service UUID
        - status: Filter by episode status (awaiting_commencement, active, on_hold, completed, closed)
      parameters:
      - in: query
        name: family_member
        schema:
          type: string
          format: uuid
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - in: query
        name: referral_service_request
        schema:
          type: string
          format: uuid
      - in: query
        name: service_id
        schema:
          type: string
          format: uuid
      - in: query
        name: status
        schema:
          type: array
          items:
            type: string
            enum:
            - active
            - awaiting_commencement
            - closed
            - completed
            - on_hold
        description: |-
          Multiple values may be separated by commas.

          * `awaiting_commencement` - Awaiting Commencement
          * `active` - Active
          * `on_hold` - On Hold
          * `completed` - Completed
          * `closed` - Closed
        explode: false
        style: form
      tags:
      - v1
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedServiceEpisodeListList'
          description: ''
