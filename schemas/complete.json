      properties:
        id:
          type: string
          format: uuid
          nullable: true
        participantType:
          allOf:
          - $ref: '#/components/schemas/ParticipantTypeEnum'
          description: |-
            Type/role of the participant (e.g., mother, father, child)

            * `mother` - Mother
            * `father` - Father
            * `child` - Child
            * `sibling` - Sibling
            * `guardian` - Guardian
            * `grandparent` - Grandparent
            * `caregiver` - Caregiver
            * `other` - Other
        name:
          type: string
          nullable: true
          description: Name of the participant
          maxLength: 255
        type:
          allOf:
          - $ref: '#/components/schemas/TypeEnum'
          description: |-
            Relationship type (family, external, friend)

            * `family` - Family
            * `external` - External
            * `friend` - Friend
        createdAt:
          type: string
          format: date-time
          readOnly: true
        updatedAt:
          type: string
          format: date-time
          readOnly: true
      required:
      - createdAt
      - name
      - participantType
      - type
      - updatedAt
