  /api/v1/dashboard/activities/:
    get:
      operationId: v1_dashboard_activities_list
      description: |-
        Case Worker Dashboard - Activity Listing (Last activity for all service users)

        Fields returned:
        - date, name, service_name, priority, risk_flag, is_telehealth, is_visit,
          outcome, activity_date, is_followup, followup_date

        Filters:
        - risk_flag: Filter by risk level (none/low/medium/high/critical)
        - priority: Filter by urgency level (routine/priority/urgent/crisis/emergency)
        - service: Filter by service ID
        - service_name: Filter by service name (partial match)

        Sorting (default: followup_date, then risk_level, then priority):
        - followup_date, risk_level, priority, date

        Role-based filtering:
        - Case Worker: Only activities from their assigned service episodes
        - Supervisor: Activities from their supervised case workers + their own
        - Program Manager/Admin: All activities in their organisation
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - v1
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedDashboardActivityListList'
          description: ''
  /api/v1/dashboard/intake-officer/referrals/:
    get:
      operationId: v1_dashboard_intake_officer_referrals_list
      description: |-
        Intake Office Dashboard - Referral List with Status Filter

        NO role checking - accessible to any authenticated user.
        Filters referrals by status (supports multiple values).

        Example usage:
        - ?status=pending_consent,pending_assessment (comma-separated)
        - ?status=draft&priority=urgent

        Fields returned:
        - All referral info fields including person details, status, priority, dates

        Filters:
        - status: Multiple status values allowed via comma-separated format
          (e.g., ?status=pending_consent,pending_assessment)
        - priority: Filter by urgency level
        - referral_date_from/to: Filter by referral date range
        - created_at_from/to: Filter by creation date range

        Note: This view intentionally does NOT perform role-based filtering.
        Organisation filtering is applied based on the authenticated user's organisation.
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - v1
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedIntakeReferralListList'
          description: ''
