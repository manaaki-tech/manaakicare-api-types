  /api/v1/service-episode/{service_episode_pk}/exit/:
    post:
      operationId: v1_service_episode_exit_create
      description: |-
        Exit/complete a service episode and its referral.

        Expected payload:
        {
            "end_date": "2025-11-30",                    // Required
            "episode_closure_reason": "uuid",            // Required
            "closer_other_reason": "string",             // Required only if episode_closure_reason is 'other'
            "closure_notes": "string",                   // Optional
            "is_follow_up_required": false,              // Optional, defaults to false
            "follow_up_date": "2025-12-15"               // Required only if is_follow_up_required is true
        }
      parameters:
      - in: path
        name: service_episode_pk
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - v1
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/service-episode/assign-staff/:
    patch:
      operationId: v1_service_episode_assign_staff_partial_update
      description: |-
        Reassign staff to a service episode.

        Required parameters:
        - episode_id: UUID
        - assigned_staff_id: UUID
        - is_primary_responsible: Boolean

        Logic:
        - If is_primary_responsible is true, set other staff's is_primary_responsible to false
        - If assigned staff already exists in the episode, update their is_primary_responsible
      tags:
      - v1
      requestBody:
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedServiceEpisodeStaffReassign'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedServiceEpisodeStaffReassign'
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedServiceEpisodeStaffReassign'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ServiceEpisodeStaffReassign'
          description: ''
  /api/v1/service-episode/create-with-staff/:
    post:
      operationId: v1_service_episode_create_with_staff_create
      description: |-
        Create a new service episode with staff assignment.

        Required parameters:
        - referral_service_request: UUID
        - start_date: Date
        - assigned_staff_id: UUID
        - is_primary_responsible: Boolean (default: True)
      tags:
      - v1
      requestBody:
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ServiceEpisodeCreate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ServiceEpisodeCreate'
          application/json:
            schema:
              $ref: '#/components/schemas/ServiceEpisodeCreate'
        required: true
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ServiceEpisodeCreate'
          description: ''
  /api/v1/services/service-contracts:
    get:
      operationId: v1_services_service_contracts_list
      description: |-
        API endpoint to list active service contracts for the logged-in user's organization.
        Returns service details instead of contract details.
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      tags:
      - v1
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedServiceContractListList'
          description: ''
  /api/v1/services/service-staff/{service_contract_id}:
    get:
      operationId: v1_services_service_staff_list
      description: |-
        API endpoint to list active staff for a specific service contract.
        Takes service_contract_id as a parameter and returns only active staff.
        Supports search by staff name, employee ID, and email.
        Supports filtering by position (comma-separated for multiple).
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - in: path
        name: service_contract_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - v1
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedServiceStaffList'
          description: ''
