  /api/v1/documents/:
    get:
      operationId: v1_documents_list
      description: |-
        ViewSet for Document model with file upload/download support.

        Provides CRUD operations and specialized endpoints:
        - GET, POST: /documents
        - GET, PUT, PATCH, DELETE: /documents/{id}
        - POST: /documents/upload (multipart file upload)
        - GET: /documents/{id}/download
        - POST: /documents/{id}/create_version
        - GET: /documents/{id}/versions
        - GET: /documents/{id}/access_logs
      parameters:
      - in: query
        name: approval_status
        schema:
          type: string
          enum:
          - approved
          - draft
          - pending
          - rejected
        description: |-
          * `draft` - Draft
          * `pending` - Pending Approval
          * `approved` - Approved
          * `rejected` - Rejected
      - in: query
        name: category
        schema:
          type: string
          format: uuid
      - in: query
        name: client
        schema:
          type: string
          format: uuid
        description: FamilyMember UUID - returns all documents for this client across
          all scopes
      - in: query
        name: content_type
        schema:
          type: integer
      - in: query
        name: document_date
        schema:
          type: string
          format: date
      - in: query
        name: entity_id
        schema:
          type: string
        description: UUID of the entity
      - in: query
        name: entity_type
        schema:
          type: string
        description: Entity model name (e.g., referral, service_user, staff)
      - in: query
        name: expiry_date
        schema:
          type: string
          format: date
      - in: query
        name: is_confidential
        schema:
          type: boolean
      - in: query
        name: is_public
        schema:
          type: boolean
      - in: query
        name: object_id
        schema:
          type: string
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - in: query
        name: scope
        schema:
          type: string
          enum:
          - general
          - organisation
          - program
          - referral
          - service_user
          - staff
        description: |-
          Document scope determines which entity type this document belongs to

          * `service_user` - Service User
          * `staff` - Staff Member
          * `program` - Program/Contract
          * `organisation` - Organisation
          * `referral` - Referral
          * `general` - General Document
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: status
        schema:
          type: string
      tags:
      - v1
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedDocumentListList'
          description: ''
