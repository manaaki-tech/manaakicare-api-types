          description: ''
  /api/v1/referral/{referral_id}/documents/:
    get:
      operationId: v1_referral_documents_list
      description: |-
        ViewSet for ReferralDocument instances.

        Provides CRUD operations for linking documents to referrals:
        - List: GET /api/v1/referral/referral-info/{referral_id}/documents/
        - Create/Upload: POST /api/v1/referral/referral-info/{referral_id}/documents/upload/
        - Retrieve: GET /api/v1/referral/referral-info/{referral_id}/documents/{id}/
        - Update: PATCH /api/v1/referral/referral-info/{referral_id}/documents/{id}/
        - Delete (soft): DELETE /api/v1/referral/referral-info/{referral_id}/documents/{id}/

        Multi-tenant isolation: Users can only access documents for referrals
        in their organisation.

        TODO: Implement permission classes for document-level access control
              based on confidentiality and service-based permissions.
      parameters:
      - in: query
        name: created_at
        schema:
          type: string
          format: date-time
      - in: query
        name: document__is_confidential
        schema:
          type: boolean
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - in: query
        name: person
        schema:
          type: string
          format: uuid
      - in: path
        name: referral_id
        schema:
          type: string
          format: uuid
        required: true
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - v1
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedReferralDocumentListList'
          description: ''
