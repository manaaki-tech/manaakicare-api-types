  /api/v1/dashboard/supervisor/analytics/:
    get:
      operationId: v1_dashboard_supervisor_analytics_retrieve
      description: |-
        Supervisor Dashboard - Analytics/Statistics

        Query params:
        - start_date: Start of date range (default: first day of current month)
        - end_date: End of date range (default: today)

        Returns:
        - total_active_episodes: Count of ServiceEpisode with status='active'
        - total_referrals_created: Count of ReferralInfo created between dates
        - total_activities_created: Count of Activity created between dates
        - total_unique_episodes_with_activities: Count of distinct ServiceEpisode IDs
          that have activities created between dates

        Role-based filtering:
        - Supervisor: Counts for their supervised case workers + their own
        - Program Manager/Admin: All records in their organisation
        - Case Worker: Only their own records
