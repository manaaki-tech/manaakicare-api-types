    ParticipantTypeEnum:
      enum:
      - mother
      - father
      - child
      - sibling
      - guardian
      - grandparent
      - caregiver
      - other
      type: string
      description: |-
        * `mother` - Mother
        * `father` - Father
        * `child` - Child
        * `sibling` - Sibling
        * `guardian` - Guardian
        * `grandparent` - Grandparent
        * `caregiver` - Caregiver
        * `other` - Other
    PatchedActivityCreateUpdate:
      type: object
      description: |-
        Serializer for creating and updating Activity.
        Handles nested create/update for visit_participants, supports, and attachments.
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        referenceNumber:
          type: string
          readOnly: true
        title:
          type: string
          description: Title of the activity
          maxLength: 255
        date:
          type: string
          format: date
          description: Date of the activity
        startTime:
          type: string
          format: time
          nullable: true
          description: Start time of the activity
        durationInMinutes:
          type: integer
          maximum: 2147483647
          minimum: 0
          nullable: true
          description: Duration of the activity in minutes
        isFollowUpRequired:
          type: boolean
          description: Whether a follow-up is required
        followUpDate:
          type: string
          format: date
          nullable: true
          description: Date for follow-up
        isReviewRequired:
          type: boolean
          description: Whether a review is required
        isReviewDone:
          type: boolean
          description: Whether the review has been completed
        reviewNote:
          type: string
          description: Notes from the review
        status:
          allOf:
          - $ref: '#/components/schemas/Status76cEnum'
          description: |-
            Status of the activity

            * `draft` - Draft
            * `saved` - Saved
            * `archived` - Archived
        outcome:
          description: |-
            Outcome of the activity

            * `completed` - Completed
            * `client_no_show` - Client No Show
            * `client_unavailable` - Client Unavailable
            * `rescheduled` - Rescheduled
            * `cancelled_by_client` - Cancelled by Client
            * `cancelled_by_staff` - Cancelled by Staff
          oneOf:
          - $ref: '#/components/schemas/OutcomeEnum'
          - $ref: '#/components/schemas/BlankEnum'
        outcomeNotes:
          type: string
          description: Notes about the outcome
        typeOfActivity:
          allOf:
          - $ref: '#/components/schemas/TypeOfActivityEnum'
          description: |-
            Type of activity

            * `direct` - Direct
            * `coordination` - Coordination
            * `administrative` - Administrative
            * `incident` - Incident
        coordinationType:
          allOf:
          - $ref: '#/components/schemas/CoordinationTypeEnum'
          description: |-
            Type of coordination if applicable

            * `none` - None
            * `internal_consultation` - Internal Consultation
            * `external_consultation_referral` - External Consultation/Referral
            * `supervision_receiving` - Supervision (Receiving)
        extraData:
          nullable: true
          description: Additional data in JSON format
        templateText:
          type: string
          description: Rich text template content
        totalConsumedTimeInMinutes:
          type: integer
          maximum: 2147483647
          minimum: 0
          nullable: true
          description: Total time consumed in minutes
        isCaseNotes:
          type: boolean
          description: Whether this activity includes case notes
        caseNoteStatus:
          allOf:
          - $ref: '#/components/schemas/CaseNoteStatusEnum'
          description: |-
            Status of the case note

            * `none` - None
            * `draft` - Draft
            * `saved` - Saved
        isVisit:
          type: boolean
          description: Whether this activity is a visit
        location:
          allOf:
          - $ref: '#/components/schemas/LocationEnum'
          description: |-
            Location of the activity

            * `none` - None
            * `home` - Home
            * `office` - Office
            * `community` - Community
            * `court` - Court
            * `school` - School
            * `other` - Other
        visitType:
          allOf:
          - $ref: '#/components/schemas/VisitTypeEnum'
          description: |-
            Type of visit

            * `none` - None
            * `scheduled` - Scheduled
            * `drop_in` - Drop-in
            * `emergency` - Emergency
        isIncident:
          type: boolean
          description: Whether this activity involves an incident
        incidentNotes:
          type: string
          description: Notes about the incident
        isTelehealth:
          type: boolean
          description: Whether this is a telehealth activity
        telehealthType:
          allOf:
          - $ref: '#/components/schemas/TelehealthTypeEnum'
          description: |-
            Type of telehealth service

            * `none` - None
            * `phone` - Phone
            * `email` - Email
            * `social_media` - Social Media
            * `video` - Video
            * `sms_text` - SMS/Text
        riskLevel:
          $ref: '#/components/schemas/RiskLevelEnum'
        riskNotes:
          type: string
        visitParticipants:
          type: array
          items:
            $ref: '#/components/schemas/VisitParticipant'
        supports:
          type: array
          items:
            $ref: '#/components/schemas/Support'
        attachments:
          type: array
          items:
            $ref: '#/components/schemas/ActivityAttachment'
        createdAt:
          type: string
          format: date-time
          readOnly: true
        updatedAt:
          type: string
          format: date-time
          readOnly: true
    PatchedChildren:
      type: object
      description: |-
        Serializer for Children model.
        Handles children information for clients.
      properties:
        id:
